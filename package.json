{
  "name": "semantic-release-steam",
  "version": "2.1.2",
  "description": "semantic-release plugin that publishes a Steam Workshop item from a built mod directory.",
  "type": "module",
  "main": "index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./lib/*": "./lib/*",
    "./schema/plugin-config.json": "./schema/plugin-config.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "lib/",
    "schema/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:check-config": "node tests/run-config-check.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "semantic-release",
    "semantic-release-plugin",
    "steam",
    "steam-workshop",
    "steamcmd",
    "release",
    "publish"
  ],
  "author": "Aaron Scherer <aequasi@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RimWorks/semantic-release-steam.git"
  },
  "bugs": {
    "url": "https://github.com/RimWorks/semantic-release-steam/issues"
  },
  "homepage": "https://github.com/RimWorks/semantic-release-steam#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "semantic-release": ">=22.0.0"
  },
  "peerDependenciesMeta": {
    "semantic-release": {
      "optional": false
    }
  },
  "dependencies": {
    "@steamdown/core": "^1.0.0-beta.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "semantic-release": "^25.0.0",
    "typescript": "^5.5.0"
  }
}
